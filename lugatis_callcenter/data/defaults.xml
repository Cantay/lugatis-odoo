<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="result_successful" model="lugatis.call.result">
        <field name="name">Başarılı</field>
        <field name="code">SUCCESSFUL</field>
        <field name="color_hex">#22c55e</field>
        <field name="sequence">10</field>
    </record>
    <record id="result_sale" model="lugatis.call.result">
        <field name="name">Satış</field>
        <field name="code">SALE</field>
        <field name="color_hex">#a855f7</field>
        <field name="sequence">20</field>
    </record>
    <record id="result_callback" model="lugatis.call.result">
        <field name="name">Geri aranacak</field>
        <field name="code">CALLBACK</field>
        <field name="color_hex">#3b82f6</field>
        <field name="sequence">30</field>
    </record>
    <record id="result_no_answer" model="lugatis.call.result">
        <field name="name">Cevap yok</field>
        <field name="code">NO_ANSWER</field>
        <field name="color_hex">#f59e0b</field>
        <field name="sequence">40</field>
    </record>
    <record id="result_busy" model="lugatis.call.result">
        <field name="name">Meşgul</field>
        <field name="code">BUSY</field>
        <field name="color_hex">#f97316</field>
        <field name="sequence">50</field>
    </record>
    <record id="result_wrong_number" model="lugatis.call.result">
        <field name="name">Yanlış numara</field>
        <field name="code">WRONG_NUMBER</field>
        <field name="color_hex">#ef4444</field>
        <field name="sequence">60</field>
    </record>
    <record id="status_available" model="lugatis.agent.status">
        <field name="name">Uygun</field>
        <field name="kind">available</field>
        <field name="color_hex">#22c55e</field>
        <field name="sequence">10</field>
    </record>
    <record id="status_manual" model="lugatis.agent.status">
        <field name="name">Manuel</field>
        <field name="kind">busy</field>
        <field name="color_hex">#6366f1</field>
        <field name="sequence">20</field>
    </record>
    <record id="status_meeting" model="lugatis.agent.status">
        <field name="name">Toplantı</field>
        <field name="kind">busy</field>
        <field name="color_hex">#14b8a6</field>
        <field name="sequence">30</field>
    </record>
    <record id="status_break" model="lugatis.agent.status">
        <field name="name">Mola</field>
        <field name="kind">break</field>
        <field name="color_hex">#f59e0b</field>
        <field name="sequence">40</field>
    </record>
    <record id="status_lunch" model="lugatis.agent.status">
        <field name="name">Yemek Molası</field>
        <field name="kind">break</field>
        <field name="color_hex">#d97706</field>
        <field name="sequence">50</field>
    </record>
</odoo>
