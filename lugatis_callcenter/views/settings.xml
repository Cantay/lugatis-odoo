<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.lugatis</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Lugatis" string="Lugatis" name="lugatis_callcenter">
                    <block title="Modül erişimi">
                        <setting string="Modülleri gruplara göre sınırla"
                                 help="Açıkken masaüstü uygulamasında her kullanıcı yalnızca Kullanıcılar → Erişim Hakları → Lugatis altında seçili modülleri görür (yöneticiler hepsini). Kapalıyken yalnızca Odoo yetkileri geçerlidir.">
                            <field name="lugatis_restrict_modules"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
