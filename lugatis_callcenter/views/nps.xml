<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nps_list" model="ir.ui.view">
        <field name="name">lugatis.nps.list</field>
        <field name="model">lugatis.nps</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="create_date" string="Gönderildi"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="score"/>
                <field name="category"/>
                <field name="comment"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_nps" model="ir.actions.act_window">
        <field name="name">Memnuniyet anketleri (NPS)</field>
        <field name="res_model">lugatis.nps</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
    <menuitem id="menu_nps" name="Memnuniyet (NPS)" parent="menu_root" action="action_nps" sequence="30"/>
</odoo>
